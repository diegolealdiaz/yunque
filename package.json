  "private": true,
  "description": "Agente de cuentas por pagar que decide dentro de reglas configurables y deja un registro explicable",
  "author": "Diego Leal <diegoleal2293@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
