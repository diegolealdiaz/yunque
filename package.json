{
  "name": "yunque",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de cuentas por pagar que decide dentro de reglas configurables y deja un registro explicable",
  "author": "Diego Leal <diegoleal2293@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "dataset": "tsx scripts/generate-dataset.ts",
    "eval": "tsx scripts/eval.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@next/env": "^16.4.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@pdfme/common": "^6.2.6",
    "@pdfme/generator": "^6.2.6",
    "@pdfme/schemas": "^6.2.6",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.143",
    "clawpdf": "^0.3.2",
    "drizzle-orm": "^0.45.4",
    "gsap": "3.15.0",
    "jpeg-js": "^0.4.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
