# Yunque. Copia este archivo a .env.local y completa los valores.
# Nunca se commitean valores. Si falta una variable requerida, la app no arranca.
# Secretos: genera cada uno con `openssl rand -hex 32`. Deben ser distintos entre sí.

# Modelo (OpenRouter). Los identificadores se confirman en openrouter.ai/models.
# La clave es obligatoria en producción. En desarrollo puede faltar: el Lector queda apagado.
OPENROUTER_API_KEY=
MODEL_PRIMARY=anthropic/claude-haiku-5.5
MODEL_FALLBACK=anthropic/claude-sonnet-5.5
MODEL_MAX_OUTPUT_TOKENS=1500

# Base de datos. Local: archivo SQLite. Producción: URL de Turso con token.
DATABASE_URL=file:./data/yunque.db
DATABASE_AUTH_TOKEN=

# Archivos subidos y páginas renderizadas. Hoy: carpeta local data/files. Vercel Blob entra con
# el despliegue (paso 29); la variable todavía no se usa.
BLOB_READ_WRITE_TOKEN=

# Firma de aprobaciones y de la cookie de visitante. Mínimo 32 bytes aleatorios.
APPROVAL_SIGNING_SECRET=
SESSION_SECRET=

# Tope absoluto del sistema por pago, fuera de la política editable. En centavos de USD.
SYSTEM_HARD_CAP_USD_CENTS=10000000

# Demo pública y topes de uso. En producción debe quedar en true: aún no hay inicio de sesión.
DEMO_MODE=true
MAX_UPLOAD_BYTES=5242880
MAX_PAGES_RENDERED=5
MAX_INVOICES_PER_VISITOR_PER_DAY=50
MAX_INVOICES_PER_DAY=500

# Presentación.
DISPLAY_TIMEZONE=America/Bogota

# Acceso de cliente (D23, D24): el código abre el correo real y la conexión de Telegram.
# Obligatorio si alguno de los dos está encendido. Mínimo 12 caracteres. Nunca va en el repo
# ni en el README: se entrega a los clientes por fuera. Cambiarlo anula el anterior.
DEMO_ACCESS_CODE=
DEMO_ACCESS_TTL_HOURS=72

# URL pública de la app (https). Los avisos de Telegram la usan para el botón "Abrir en
# Yunque". En local queda vacía y el aviso va sin botón.
PUBLIC_APP_URL=

# Correo real de la demo para clientes (D23). Apagado por defecto.
# INBOUND_EMAIL_ADDRESS: la dirección de entrada que da Postmark, sin nada después del +.
# INBOUND_EMAIL_WEBHOOK_SECRET: contraseña del webhook; va en la URL que se configura en
#   Postmark (https://yunque:<secreto>@<dominio>/api/correo/entrante). Genérala con openssl.
INBOUND_EMAIL_ENABLED=false
INBOUND_EMAIL_ADDRESS=
INBOUND_EMAIL_WEBHOOK_SECRET=
MAX_INBOUND_EMAILS_PER_ADDRESS_PER_DAY=10
MAX_INBOUND_EMAILS_PER_DAY=60

# Bot de Telegram (D24, opcional). Van las tres juntas o ninguna; sin ellas el aviso por
# Telegram queda simulado (D21) y la pantalla no ofrece conectarlo.
# TELEGRAM_BOT_TOKEN: el que da @BotFather al crear el bot.
# TELEGRAM_WEBHOOK_SECRET: 32 a 256 letras, números, _ o -. Genéralo con openssl rand -hex 32
#   y pásalo como secret_token al registrar el webhook.
# TELEGRAM_BOT_USERNAME: el nombre del bot sin @, para el enlace t.me/<bot>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MAX_PER_CHAT_PER_DAY=10
